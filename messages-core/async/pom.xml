<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-messages-core-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>staffix-messages-core-async</artifactId>

    <name>Staffix Asynchronous Store Core</name>
    <description>
        What both asynchronous wrappers are built on: a persistent queue backed by Chronicle Queue, the events and
        serdes that cross it, the consumer threads that drain it, and the listeners that report queue depth and an
        underlying resource going down.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.stores.core.async</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.openhft</groupId>
            <artifactId>chronicle-queue</artifactId>
            <version>2026.6</version>
            <exclusions>
                <exclusion>
                    <groupId>net.openhft</groupId>
                    <artifactId>chronicle-analytics</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>