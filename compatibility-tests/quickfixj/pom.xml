<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-compatibility-tests</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-compatibility-tests-quickfixj</artifactId>

    <name>Staffix QuickFIX/J Compatibility Tests</name>
    <description>
        Interoperability with QuickFIX/J 3.0.1, driven in-process: a real QuickFIX/J engine on one end of the
        session and Staffix on the other, either way round, across the FIX versions both speak.
    </description>
    <properties>
        <quickfixj-core.version>3.0.2</quickfixj-core.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-impl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- every dictionary staffix ships gets a logon and an Email each way against QuickFIX/J; the field and
             message registries are looked up per dictionary, so they coexist on one classpath -->
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fix-42</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fix-43</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fix-50</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fix-50sp1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fix-44</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- pulls staffix-fixt-11, the transport dictionary the FIXT scenarios run over -->
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fix-50sp2</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-application-factory-simple</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-sessions-settings-store-memory-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-test-utils</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-core</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix42</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix43</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix50</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix50sp1</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix44</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix50sp2</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>