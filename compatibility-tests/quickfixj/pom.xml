<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-compatibility-tests</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-compatibility-tests-quickfixj</artifactId>

    <name>Staffix QuickFIX/J Compatibility Tests</name>
    <description>
        Interoperability with QuickFIX/J 3.0.1, driven in-process: a real QuickFIX/J engine on one end of the
        session and Staffix on the other, either way round, across the FIX versions both speak.
    </description>
    <properties>
        <quickfixj-core.version>3.0.2</quickfixj-core.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-impl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-application-factory-simple</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-sessions-settings-store-memory-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-test-utils</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fixt-11</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-core</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix42</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix43</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix50</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix50sp1</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix44</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-messages-fix50sp2</artifactId>
            <version>${quickfixj-core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- every dictionary staffix ships gets a logon and an Email each way against QuickFIX/J. FIX 4.4 and 5.0 SP2
                 come from test-utils and FIXT.1.1 from staffix-fixt-11; the others are generated from the shipped dictionaries cut to the
                 session messages, BusinessMessageReject (the engine registers a decoder for it) and Email, then
                 sanitized, so as not to generate thousands of unused classes -->
            <plugin>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-fix-encoders-generator-maven-plugin</artifactId>
                <version>${project.version}</version>
                <configuration>
                    <sourcesOutputDirectory>${project.build.directory}/generated-test-sources/fix</sourcesOutputDirectory>
                    <resourcesOutputDirectory>${project.build.testOutputDirectory}</resourcesOutputDirectory>
                    <testSources>true</testSources>
                </configuration>
                <executions>
                    <execution>
                        <id>fix42</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>src/test/resources/dictionaries/FIX42-email.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.fix42</packageName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fix43</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>src/test/resources/dictionaries/FIX43-email.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.fix43</packageName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fix50</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>src/test/resources/dictionaries/FIX50-email.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.fix50</packageName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fix50sp1</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>src/test/resources/dictionaries/FIX50SP1-email.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.fix50sp1</packageName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
