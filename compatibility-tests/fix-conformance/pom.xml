<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-compatibility-tests</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-fix-conformance-tests</artifactId>

    <name>Staffix FIX Conformance Tests</name>
    <description>
        The official FIX session conformance cases from FIX_Session_Testcases_June_2020, as executable
        TestScenarioNN tests that run on every build. Each carries the specification's condition, stimulus and
        expected behaviour in its comments, so a failure names the clause it broke.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fix-44</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-application-factory-simple</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-messages-store-test-kit</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-sessions-settings-store-memory-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-test-utils</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>