<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-parent</artifactId>
        <version>0.9.2-SNAPSHOT</version>
    </parent>
    <artifactId>staffix-claude-plugin-archive</artifactId>
    <packaging>pom</packaging>
    <name>Staffix Claude Plugin Archive</name>
    <description>
        The Claude Code plugin as a zip, and the marketplace.json listing it, both attached to the GitHub Release.
    </description>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <claude.plugin.dir>${project.basedir}/../claude-plugin</claude.plugin.dir>
        <claude.plugin.archive>staffix-claude-plugin-${project.version}</claude.plugin.archive>
        <claude.plugin.download.url>https://github.com/lolaf-org/staffix/releases/download/v${project.version}</claude.plugin.download.url>
    </properties>
    <dependencies>
        <!-- claude-plugin/catalogue links to its build output -->
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-components-catalogue</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>zip-claude-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="staging" value="${project.build.directory}/claude-plugin"/>
                                <property name="zip" value="${project.build.directory}/${claude.plugin.archive}.zip"/>
                                <!-- a copy follows the symlinks, where a zip of the directory would store them as links -->
                                <delete dir="${staging}"/>
                                <copy todir="${staging}">
                                    <fileset dir="${claude.plugin.dir}" excludes="**/target/**"/>
                                </copy>
                                <replaceregexp file="${staging}/.claude-plugin/plugin.json"
                                               match="\$\{project\.version\}" replace="${project.version}"/>
                                <zip destfile="${zip}" basedir="${staging}"
                                     modificationtime="${project.build.outputTimestamp}"/>
                                <checksum file="${zip}" algorithm="SHA-256" property="claude.plugin.sha256"/>
                                <copy file="src/marketplace/marketplace.json" todir="${project.build.directory}"
                                      overwrite="true">
                                    <filterset>
                                        <filter token="URL" value="${claude.plugin.download.url}/${claude.plugin.archive}.zip"/>
                                        <filter token="SHA256" value="${claude.plugin.sha256}"/>
                                    </filterset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
