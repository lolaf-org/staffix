<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-parent</artifactId>
        <version>0.9.1-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-test-utils</artifactId>

    <name>Staffix Test Utilities</name>
    <description>
        Test helpers shared across the library, shipped as a test-jar: FIX message assertions, a raw socket client
        that speaks the wire format, a controllable Clock, port reservation, and stores and loggers that record what
        they were handed.
    </description>

    <properties>
        <sonar.coverage.exclusions>**/*</sonar.coverage.exclusions>
        <automatic.module.name>org.lolaf.staffix.tests</automatic.module.name>
        <!-- Internal scaffolding, not part of the published surface: staffix is meant to be extended, but
             through the test kits, which carry the contracts an implementation must satisfy. Nothing here
             is one of those. Re-expressed in the root pom's excludeArtifacts, because this property belongs
             to maven-deploy-plugin and central-publishing replaces it. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-codec</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The FIX versions most tests need, generated once here for every module using test-utils; FIX 5.0 SP2
                 runs over staffix-fixt-11, which a module using it adds. The resources go to test-classes with the
                 sources, or the service registrations would land in the main jar and not in the test-jar. -->
            <plugin>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-fix-encoders-generator-maven-plugin</artifactId>
                <version>${project.version}</version>
                <configuration>
                    <sourcesOutputDirectory>${project.build.directory}/generated-test-sources/fix</sourcesOutputDirectory>
                    <resourcesOutputDirectory>${project.build.testOutputDirectory}</resourcesOutputDirectory>
                    <testSources>true</testSources>
                </configuration>
                <executions>
                    <execution>
                        <id>fix44</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>classpath:FIX44.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.fix44</packageName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fix50sp2</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>classpath:FIX50SP2.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.fix50sp2</packageName>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.lolaf.staffix</groupId>
                        <artifactId>staffix-fix-44</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.lolaf.staffix</groupId>
                        <artifactId>staffix-fix-50sp2</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- This module is test-only code with no src/main/java, so neither javadoc nor the source plugin
                 produces anything.
                 Central requires a -javadoc.jar (and a -sources.jar) for every artifact whose packaging is
                 not pom, and sanctions a placeholder where neither can be produced: "if you cannot provide
                 sources or documentation, we allow uploading placeholder .jar files in order to pass
                 validation". src/placeholder/README.md says so and points at where to look instead. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>placeholder-javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/placeholder</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>placeholder-sources-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>sources</classifier>
                            <classesDirectory>${project.basedir}/src/placeholder</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate test-jar artifact -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <!-- The classes are all in src/test, so the test-jar is the artifact that
                                 lands on a consumer's module path; default-jar's manifest entries do not
                                 reach a separate execution. -->
                            <archive>
                                <manifestEntries>
                                    <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>