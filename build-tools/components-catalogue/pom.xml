    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <!-- Central wants sources and javadoc jars, which a module without code does not produce -->
                    <execution>
                        <id>sources-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>sources</classifier>
                            <classesDirectory>${project.basedir}/src/main/readme</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/main/readme</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-component-metadata-maven-plugin</artifactId>
                <executions>
                    <!-- the execution pluginManagement binds describes components, which this module has none of -->
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>catalogue</id>
                        <goals>
                            <goal>generate-components-catalogue</goal>
                        </goals>
                        <configuration>
                            <documentation>
                                <directory>${maven.multiModuleProjectDirectory}/docs</directory>
                                <directory>${maven.multiModuleProjectDirectory}/claude-plugin/references</directory>
                                <directory>${maven.multiModuleProjectDirectory}/claude-plugin/skills</directory>
                            </documentation>
                            <!-- Maven properties of the generated projects, which the plugin's guides name in prose -->
                            <ignoredKeys>
                                <ignoredKey>staffix.version</ignoredKey>
                                <ignoredKey>staffix.jvm.args</ignoredKey>
                            </ignoredKeys>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
