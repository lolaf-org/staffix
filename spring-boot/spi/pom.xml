<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-spring-boot-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-spring-boot-spi</artifactId>

    <name>Staffix Spring Boot SPI</name>
    <description>
        The contracts every Spring Boot module implements so the starter can assemble an engine from properties:
        settings contributors for stores, loggers, plugins and admin APIs, and the post-processor that amends each
        session's settings before the engine is built.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.spring.boot.spi</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
    </dependencies>
</project>