<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-http-client-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-http-client-jdk</artifactId>

    <name>Staffix HTTP Client (JDK)</name>
    <description>
        HttpSender on java.net.http. The default because it adds no dependency, not because it is the fastest:
        prefer staffix-http-client-okhttp for an HTTPS collector, or staffix-http-client-jetty over plaintext. It
        cannot serve gRPC - java.net.http exposes no HTTP/2 trailers.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.http.jdk</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-http-client-test-kit</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
