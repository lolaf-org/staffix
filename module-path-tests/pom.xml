    <artifactId>staffix-module-path-tests</artifactId>

    <name>Staffix Module Path Tests</name>
    <description>
        Proves every published jar is usable on the module path and not only the classpath: no split package, the
        whole set resolves, every jar names itself, every package sits under its module's name, and the jar count
        matches the published total. Nothing else in the build can see these failures, because every other test runs
        on the classpath, where a jar's module name is never read.
    </description>

    <!--
      Resolves every published staffix jar as a JPMS module, which no other module can do: the check needs the whole
      published set at once, and nothing in this reactor depends on all of it. That is the only reason this module
      exists - it ships nothing, and the dependency list below is its subject matter rather than something it uses.

      A module added to the release bundle and not to that list is unchecked, so the test asserts the count.
    -->

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <delombok.skip>true</delombok.skip>
        <javadoc.delomboked.sources>${project.basedir}/src/main/java</javadoc.delomboked.sources>
    </properties>

