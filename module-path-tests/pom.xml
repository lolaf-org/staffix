    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>collect-module-path</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/module-path</outputDirectory>
                            <!-- The jars only. A third-party jar on the path would make the test fail on
                                 splits between libraries nobody here controls. -->
                            <includeGroupIds>org.lolaf.staffix</includeGroupIds>
                            <!-- Versioned file names on purpose: the name-derivation heuristic this guards
                                 against reads the file name, so stripping the version would hide it. -->
                            <stripVersion>false</stripVersion>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

