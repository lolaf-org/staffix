<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-messages-logger-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>staffix-messages-logger-demux</artifactId>

    <name>Staffix Demultiplexing Message Logger</name>
    <description>
        Fans every message out to several loggers at once, so one session can log to a file and to an OTLP collector
        without either logger knowing about the other.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.stores.loggers.demux</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-messages-logger-core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>