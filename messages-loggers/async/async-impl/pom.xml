<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-messages-logger-async-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>staffix-messages-logger-async-impl</artifactId>

    <name>Staffix Asynchronous Message Logger</name>
    <description>
        Wraps any message logger so the write leaves the FIX thread, over the same persistent queue the asynchronous
        message store uses.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.stores.loggers.async</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-messages-core-async</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-impl-all</artifactId>
            <version>${ringos.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-test-utils</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>