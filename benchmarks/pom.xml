<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-benchmarks</artifactId>
    <packaging>jar</packaging>

    <name>Staffix Benchmarks</name>
    <description>
        The JMH benchmarks: the FIX engine round trip against QuickFIX/J and Artio on one harness, the serdes per
        value width and direction, the identifier generators and the clock. Every run's raw JSON is kept under
        benchmarks/results, so a number quoted in the documentation can be traced to the file it came from.
    </description>

    <properties>
        <!-- Hand-written sources here reference FIX encoders generated into target/generated-sources
             in this same module, so javadoc needs both on its source path. -->
        <javadoc.sourcepath>${javadoc.delomboked.sources}${path.separator}${project.build.directory}/generated-sources
        </javadoc.sourcepath>
        <quickfix.version>3.0.2</quickfix.version>
        <artio.version>0.184</artio.version>
        <otel.version>1.66.0</otel.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-impl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-messages-store-memory-impl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-sessions-settings-store-memory-impl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-messages-logger-slf4j-impl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-application-factory-simple</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-monitoring-micrometer-otlp-impl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The clients under test. Each is a module of its own, so the benchmark asks for all three. -->
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-http-client-jdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-http-client-okhttp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Brings jetty-client with it, and the Java 17 baseline that comes with Jetty 12. -->
        <!-- The gRPC receiver OtlpGrpcSenderBenchmark runs out of process. gRPC needs HTTP/2 and
             trailers, which the raw-socket StubOtlpServer cannot serve and MockWebServer already can.
             Benchmarks are not published, so this costs a consumer nothing. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver3</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-http-client-jetty</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- For OtlpTracingExportBenchmark. Note that opentelemetry-exporter-otlp brings OTel's own
             OkHttp sender transitively, which is deliberate here and only here: the benchmark wants both
             HttpSenderProviders on the classpath and picks between them per arm through the
             io.opentelemetry.sdk.common.export.HttpSenderProvider system property. -->
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-monitoring-tracing-otlp-sender</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>${otel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-trace</artifactId>
            <version>${otel.version}</version>
        </dependency>

        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-core</artifactId>
            <version>${quickfix.version}</version>
        </dependency>

        <dependency>
            <groupId>uk.co.real-logic</groupId>
            <artifactId>artio-core</artifactId>
            <version>${artio.version}</version>
        </dependency>

        <dependency>
            <groupId>uk.co.real-logic</groupId>
            <artifactId>artio-session-codecs</artifactId>
            <version>${artio.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-fix-dictionary-sanitizer-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>sanitize-fix</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>sanitize</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/src/main/resources/FIX44-benchmarks.xml</inputFile>
                            <outputFile>${project.basedir}/src/main/resources/FIX44-benchmarks-sanitized.xml
                            </outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-sources</phase>
                    </execution>
                </executions>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>--add-opens</argument>
                        <argument>java.base/jdk.internal.misc=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath>
                            <dependency>uk.co.real-logic:artio-codecs</dependency>
                            <dependency>uk.co.real-logic:sbe-tool</dependency>
                            <dependency>org.agrona:agrona</dependency>
                        </classpath>
                        <argument>uk.co.real_logic.artio.dictionary.CodecGenerationTool</argument>
                        <argument>${project.build.directory}/generated-sources</argument>
                        <argument>${project.basedir}/src/main/resources/FIX44-benchmarks-sanitized.xml</argument>
                    </arguments>

                </configuration>
            </plugin>
            <plugin>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-fix-encoders-generator-maven-plugin</artifactId>
                <version>${project.version}</version>
                <configuration>
                    <dictionaryFile>${project.basedir}/src/main/resources/FIX44-benchmarks-sanitized.xml
                    </dictionaryFile>
                    <sourcesOutputDirectory>${project.build.directory}/generated-sources</sourcesOutputDirectory>
                    <packageName>org.lolaf.staffix.benchmarks.fix44</packageName>
                    <dictionaryId>benchmarks</dictionaryId>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.quickfixj</groupId>
                <artifactId>quickfixj-codegenerator</artifactId>
                <version>3.0.2</version>
                <!-- do not change 3.0.2 requires a recent version of maven -->
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <dictFile>${project.basedir}/src/main/resources/FIX44-benchmarks-sanitized.xml</dictFile>
                            <packaging>org.lolaf.staffix.benchmarks.quickfix.fix44</packaging>
                            <fieldPackage>org.lolaf.staffix.benchmarks.quickfix.fix44.field</fieldPackage>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>