<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn" strict="true">

    <Appenders>
        <Appender type="Console" name="STDOUT">
            <Layout type="PatternLayout" pattern="[%-level] %d{HH:mm:ss.SSS} %X - %msg%n"/>
        </Appender>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="STDOUT"/>
        </Root>
    </Loggers>
</Configuration>
