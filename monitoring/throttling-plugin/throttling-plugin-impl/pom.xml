<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-monitoring-throttling-plugin-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>staffix-monitoring-throttling-plugin-impl</artifactId>

    <name>Staffix Throttling Session Plugin</name>
    <description>
        Wraps another session plugin and rate-limits the per-message callbacks that reach it, for a delegate that
        cannot keep up with peak throughput. Transparent to the engine, like the asynchronous wrapper.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.plugins.throttling</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-lib-api</artifactId>
            <version>${ringos.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-lib-impl-unsafe</artifactId>
            <version>${ringos.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-impl-all</artifactId>
            <version>${ringos.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
