<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-monitoring-async-plugin-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>staffix-monitoring-async-plugin-impl</artifactId>

    <name>Staffix Asynchronous Session Plugin</name>
    <description>
        Wraps another session plugin so its per-session callbacks are replayed on a shared consumer pool, off the
        latency-critical message path. Transparent to the engine and to session configuration: it reports the
        delegate's instance id and plugin class.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.plugins.async</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-lib-api</artifactId>
            <version>${ringos.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-lib-impl-unsafe</artifactId>
            <version>${ringos.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-impl-all</artifactId>
            <version>${ringos.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
