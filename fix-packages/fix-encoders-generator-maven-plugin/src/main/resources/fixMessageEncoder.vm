import org.lolaf.staffix.api.codec.FixMessageEncodingListener;
import org.lolaf.staffix.api.codec.FixFieldsEncoder;
import static ${messagesTypePackage}.MessageTypes.${messageName};
## a deprecated class is not imported but named in full where it is used: an import is the one place
## @SuppressWarnings cannot reach, since it sits outside the class the annotation would go on
#foreach($g in ${groups})
#if (!${g.field.deprecated})
import ${fieldsPackage}.${g.field.name};
#end
#end
import org.lolaf.staffix.api.msg.MessageType;
import org.lolaf.staffix.api.fields.FixField;
import org.lolaf.staffix.api.serde.DecimalFloat;
import org.lolaf.staffix.api.serde.SerDe;
