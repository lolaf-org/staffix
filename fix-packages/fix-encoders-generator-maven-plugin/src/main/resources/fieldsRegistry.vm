package $packageName;

import org.lolaf.staffix.api.FixDictionaryId;
import org.lolaf.staffix.api.version.FixVersion;
import org.lolaf.staffix.api.version.FixRegularVersion;
import org.lolaf.staffix.api.fields.FieldsRegistry;
import org.lolaf.staffix.api.fields.FieldType;
import org.lolaf.staffix.api.fields.FieldLocation;
import org.lolaf.staffix.api.fields.FixField;
import org.lolaf.staffix.api.fields.FixFieldImpl;
import org.lolaf.staffix.collections.Int2ObjectHashMap;

import java.io.IOException;
import java.io.InputStream;
import java.lang.reflect.Method;
import java.util.Arrays;
import java.util.Collection;
import java.util.function.IntSupplier;
import java.util.stream.Collectors;

public class FieldsRegistryImpl implements FieldsRegistry {

    private static final FixVersion TARGET_VERSION = FixRegularVersion.${fixVersionId};
    private static final String TARGET_DICTIONARY_ID = "${dictionaryId}";

    private final Int2ObjectHashMap<FixField> fixFields;
    private final FixDictionaryId fixDictionaryId;

    public FieldsRegistryImpl() {
        this.fixDictionaryId = new FixDictionaryId(TARGET_DICTIONARY_ID, TARGET_VERSION);
        String resourceName = TARGET_VERSION.getId() + "." + fixDictionaryId.getId() + ".fields";
        try (InputStream fields = this.getClass().getClassLoader().getResourceAsStream(resourceName)) {
            if (fields == null) {
                throw new IllegalStateException("Unable to find resource " + resourceName + " in classpath");
            }
            String[] entries = new String(fields.readAllBytes()).split("\n");
            fixFields = new Int2ObjectHashMap<>(entries.length, 0.1f);
            Arrays.stream(entries).forEach(codeAndClassName -> {
                String[] codeAndClassNameArray = codeAndClassName.split("=");
                try {
                    Class<?> fieldClass = Class.forName(codeAndClassNameArray[1]);
                    Method instanceMethod = fieldClass.getMethod("get");
                    FixField instance = (FixField) instanceMethod.invoke(null);
                    fixFields.put(Integer.parseInt(codeAndClassNameArray[0]), instance);
                } catch (Exception e) {
                    throw new IllegalStateException("Should have never happened", e);
                }
            });
        } catch (IOException e) {
            throw new IllegalStateException("Should have never happened", e);
        }
        fixFields.compact();
    }

    @Override
    public Collection<FixField> getFields() {
        return fixFields.values();
    }

    @Override
    public FixDictionaryId getTargetDictionary() {
        return fixDictionaryId;
    }

    @Override
    public FixField find(int code) {
        return fixFields.get(code);
    }

    @Override
    public FixField addUserDefinedField(int code, FieldType fieldType, FieldLocation location) {
        if (!FixField.isUserDefined(code)) {
            throw new IllegalArgumentException("Field code " + code + " is outside the user defined tags range, see FixField.isUserDefined(int)");
        }
        synchronized (fixFields) {
            FixField instance = fixFields.get(code);
            if (instance != null) {
                return instance;
            }
            int nextIndexableFieldIndex = getFields().stream().map(IntSupplier::getAsInt).max(Integer::compareTo).orElseThrow() + 1;
            instance = new FixFieldImpl(code, nextIndexableFieldIndex, fieldType, location);
            fixFields.put(code, instance);
            fixFields.compact();
            return instance;
        }
    }
}