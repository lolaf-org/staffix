package $packageName;

import org.lolaf.staffix.api.msg.MessageType;

public enum MessageTypes implements MessageType {

    #foreach($v in ${messagesType})
    #if (${v.deprecated})
    /** @deprecated deprecated by the FIX standard. */
    @Deprecated
    #end
    ${v.text}

    #end

    private final String code;
    private final byte[] serialized;

    MessageTypes(String code) {
        this.code = code.intern();
        this.code.hashCode(); // preload hashCode computation
        this.serialized = code.getBytes();
    }

    @Override
    public int getAsInt() {
        return ordinal();
    }

    @Override
    public String code() {
        return code;
    }

    @Override
    public byte[] serialized() {
        return serialized;
    }
}