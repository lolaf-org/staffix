package $packageName;

import org.lolaf.staffix.api.FixDictionaryId;
import org.lolaf.staffix.api.version.FixRegularVersion;
import org.lolaf.staffix.api.version.FixVersion;
import org.lolaf.staffix.api.fields.FieldsRegistry;
import ${packageName}.MessageTypes;

public class MessageFieldsRegistryImpl extends AbstractMessageFieldsRegistry {

    private static final FixVersion TARGET_VERSION = FixRegularVersion.${fixVersionId};
    private static final FixDictionaryId DICTIONARY_ID = new FixDictionaryId(AbstractMessageFieldsRegistry.TARGET_DICTIONARY_ID, TARGET_VERSION);

    public MessageFieldsRegistryImpl() {
        super(FieldsRegistry.Registry.getInstance(new FixDictionaryId(AbstractMessageFieldsRegistry.TARGET_DICTIONARY_ID, TARGET_VERSION)), TARGET_VERSION);
    }

    @Override
    public FixDictionaryId getTargetDictionary() {
        return DICTIONARY_ID;
    }
}