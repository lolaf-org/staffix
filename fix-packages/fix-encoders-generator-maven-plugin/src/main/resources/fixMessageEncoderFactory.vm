package $packageName;

import org.lolaf.staffix.api.FixDictionaryId;
import org.lolaf.staffix.api.codec.FixMessageEncoder;
import org.lolaf.staffix.api.codec.FixMessageEncoderFactory;
import org.lolaf.staffix.api.codec.FixMessageEncodingListener;
import org.lolaf.staffix.api.time.Clock;
import org.lolaf.staffix.api.version.FixRegularVersion;
import org.lolaf.staffix.api.version.FixVersion;

import java.nio.ByteBuffer;
import java.util.function.Consumer;
import java.util.function.IntFunction;

public class FixMessageEncoderFactoryImpl implements FixMessageEncoderFactory {

    private static final FixVersion TARGET_VERSION = FixRegularVersion.${fixVersionId};
    private static final String TARGET_DICTIONARY_ID = "${dictionaryId}";
    private static final FixDictionaryId DICTIONARY_ID = new FixDictionaryId(TARGET_DICTIONARY_ID, TARGET_VERSION);

    @Override
    public FixDictionaryId getTargetDictionaryId() {
        return DICTIONARY_ID;
    }

    @Override
    public boolean isFactoryFor(Class<? extends FixMessageEncoder<?>> encoderClass) {
        return FixMessageEncoderRegistry.containsEncoder(encoderClass);
    }

    @Override
    public <T extends FixMessageEncoder<?>> T newInstance(Class<T> encoderClass, Consumer<FixMessageEncoder<?>> releaser,
                                                          IntFunction<ByteBuffer> allocator, FixMessageEncodingListener listener, Clock clock) {
        return FixMessageEncoderRegistry.newInstance(encoderClass, releaser, allocator, listener, clock);
    }
}
