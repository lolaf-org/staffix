package $packageName;

import org.lolaf.staffix.api.FixDictionaryId;
import org.lolaf.staffix.api.version.FixtVersion;
import org.lolaf.staffix.api.fields.FixtFieldsRegistry;
import org.lolaf.staffix.api.msg.FixtMessageFieldsRegistry;
import ${packageName}.MessageTypes;

public class MessageFieldsRegistryImpl extends AbstractMessageFieldsRegistry implements FixtMessageFieldsRegistry {

    private static final FixtVersion TARGET_VERSION = FixtVersion.${fixVersionId};

    public MessageFieldsRegistryImpl() {
        super(FixtFieldsRegistry.Registry.getInstance(TARGET_VERSION), TARGET_VERSION);
    }

    @Override
    public FixtVersion getFixtVersion() {
        return TARGET_VERSION;
    }

    @Override
    public FixDictionaryId getTargetDictionary() {
        throw new IllegalStateException("Should never have been called");
    }
}