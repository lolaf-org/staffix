<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-fix-packages-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-fix-orchestra</artifactId>

    <name>Staffix FIX Orchestra Repository</name>
    <description>
        The FIX Trading Community's Orchestra repository, kept whole and unmodified as a zip so that 8 MB of XML
        need not live in a source tree. Every dictionary cut from the standard reads this file.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.fix.orchestra.repository</automatic.module.name>
    </properties>

    <build>
        <plugins>
            <!-- A repository and nothing to document. Central requires a -javadoc.jar for every artifact whose
                 packaging is not pom, and accepts a placeholder where none can be produced. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>placeholder-javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/placeholder</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
