<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-fix-packages-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-fix-50sp1</artifactId>

    <name>Staffix FIX 5.0 SP1 Dictionary</name>
    <description>
        The FIX 5.0 SP1 dictionary, as the classpath resource FIX50SP1.xml. Generate encoders from it with
        staffix-fix-encoders-generator-maven-plugin. Application messages only: add staffix-fixt-11 for the FIXT.1.1
        session layer.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.fix50sp1</automatic.module.name>
        <!-- FIX.5.0SP1 holds EP76-97 -->
        <orchestration.ep>76</orchestration.ep>
    </properties>

    <build>
        <plugins>
            <!-- A dictionary and nothing to document. Central requires a -javadoc.jar for every artifact whose
                 packaging is not pom, and accepts a placeholder where none can be produced. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>placeholder-javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/placeholder</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>orchestra-dictionary</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.lolaf.staffix</groupId>
                        <artifactId>staffix-fix-orchestra-dictionary-generator-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <configuration>
                            <upToVersion>FIX.5.0SP1</upToVersion>
                            <upToExtensionPack>${orchestration.ep}</upToExtensionPack>
                            <markDeprecated>${orchestration.markDeprecated}</markDeprecated>
                            <outputFile>${project.basedir}/src/main/resources/FIX50SP1.xml</outputFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>orchestra-dictionary</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
