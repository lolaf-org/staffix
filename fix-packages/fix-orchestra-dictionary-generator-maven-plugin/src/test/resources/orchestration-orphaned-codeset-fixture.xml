    </fixr:components>

    <fixr:messages>
        <fixr:message id="11" name="Logon" msgType="A" category="Session" added="FIX.2.7">
            <fixr:structure>
                <fixr:componentRef id="1024" presence="required" added="FIX.2.7"/>
                <fixr:fieldRef id="1039" added="FIX.4.4" addedEP="8"/>
                <fixr:componentRef id="1025" presence="required" added="FIX.2.7"/>
            </fixr:structure>
        </fixr:message>
    </fixr:messages>
</fixr:repository>
