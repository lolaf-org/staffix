    <fixr:codeSets>
        <fixr:codeSet id="9002" name="SettlMethodCodeSet" type="String" added="FIX.5.0" addedEP="52">
            <fixr:code id="9002001" name="CashSettlement" value="C" added="FIX.5.0" addedEP="52"/>
            <fixr:code id="9002002" name="PhysicalSettlement" value="P" added="FIX.5.0" addedEP="52"/>
        </fixr:codeSet>
    </fixr:codeSets>

    <fixr:fields>
        <fixr:field id="34" name="MsgSeqNum" type="SeqNum" added="FIX.2.7"/>
        <fixr:field id="10" name="CheckSum" type="String" added="FIX.2.7"/>
        <fixr:field id="1039" name="UnderlyingSettlMethod" type="SettlMethodCodeSet" added="FIX.4.4" addedEP="8"/>
    </fixr:fields>

    <fixr:components>
        <fixr:component id="1024" name="StandardHeader" category="Session" added="FIX.4.0">
            <fixr:fieldRef id="34" presence="required" added="FIX.4.0"/>
