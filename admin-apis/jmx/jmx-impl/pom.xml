<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.staffix</groupId>
        <artifactId>staffix-admin-api-jmx-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>staffix-admin-api-jmx-impl</artifactId>

    <name>Staffix JMX Admin API</name>
    <description>
        Exposes the engine and each session as MBeans, so session state and sequence numbers can be read, and a
        session started or stopped, from any JMX console.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.staffix.admin.jmx</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-api</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
